/* MANARA Messenger - light. Generated from docs/design/tokens.json.
 * Install: copy to the user theme folder as custom.qss (see docs/THEME.md).
 * Object names below are the real ones from the .ui files (verified against
 * the .ui files under src/gui); not yet checked visually on Windows. */

QWidget#MainWindow, QWidget#ChatWindow, QWidget#TransferWindow, QDialog#SettingsDialog {
  background: #F5F7FB; color: #0F1A3A;
}

/* ---- main window ---- */
QFrame#frame { background: #FFFFFF; border: 1px solid #E3E8F1; border-radius: 12px; }
QLabel#lblUserName { color: #0F1A3A; font-weight: 600; }
QLabel#lblStatus { color: #5B6785; }
QLineEdit#txtNote { background: transparent; border: 1px solid transparent; border-radius: 8px; color: #5B6785; padding: 2px 6px; }
QLineEdit#txtNote:hover, QLineEdit#txtNote:focus { background: #FFFFFF; border-color: #D9E0EE; color: #0F1A3A; }
QWidget#wgtToolBar { background: #FFFFFF; border-top: 1px solid #E3E8F1; }
QTreeWidget#tvUserList { background: #FFFFFF; border: 1px solid #E3E8F1; border-radius: 12px; outline: 0; }

/* ---- chat window ---- */
QTextEdit#txtMessage { background: #FFFFFF; border: 1px solid #D9E0EE; border-radius: 12px; color: #0F1A3A; padding: 6px; selection-background-color: #1E4FC2; selection-color: #FFFFFF; }
QTextEdit#txtMessage:focus { border-color: #1E4FC2; }
QToolBar#toolBar { background: transparent; border: none; spacing: 4px; }
QSplitter#splitter::handle { background: #E3E8F1; }

/* ---- transfer window ---- */
QListView#lvTransferList { background: #FFFFFF; border: 1px solid #E3E8F1; border-radius: 12px; outline: 0; }
QWidget#TransferWindow QPushButton#btnClear, QWidget#TransferWindow QPushButton#btnClose { min-height: 28px; }

/* ---- buttons (all windows) ---- */
QPushButton { background: #FFFFFF; color: #0F1A3A; border: 1px solid #D9E0EE; border-radius: 8px; padding: 5px 14px; }
QPushButton:hover { border-color: #1E4FC2; }
QPushButton:pressed { background: #EAF1FD; }
QPushButton:disabled { color: #5B6785; background: #F5F7FB; }
QPushButton:default { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #2C6BD8, stop:1 #1B3D9F); color: #FFFFFF; border: 1px solid #1B3D9F; }

/* ---- settings ---- */
QListWidget#lvCategories { background: #FFFFFF; border: 1px solid #E3E8F1; border-radius: 12px; outline: 0; }
QListWidget#lvCategories::item { padding: 8px 10px; border-radius: 8px; }
QListWidget#lvCategories::item:selected { background: #EAF1FD; color: #0F1A3A; border: 1px solid #CFE0FA; }
QGroupBox { border: 1px solid #E3E8F1; border-radius: 10px; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #5B6785; }
QLineEdit, QPlainTextEdit, QSpinBox, QComboBox { background: #FFFFFF; color: #0F1A3A; border: 1px solid #D9E0EE; border-radius: 8px; padding: 3px 6px; }
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #1E4FC2; }
QCheckBox, QRadioButton, QLabel { color: #0F1A3A; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #D9E0EE; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { background: #FFFFFF; color: #0F1A3A; border: 1px solid #D9E0EE; padding: 4px 6px; }

/* ---- menus and tool bars ---- */
QMenuBar { background: #F5F7FB; color: #0F1A3A; }
QMenuBar::item { padding: 6px 12px; border-radius: 8px; background: transparent; }
QMenuBar::item:selected { background: #EAF1FD; }
QMenu { background: #FFFFFF; color: #0F1A3A; border: 1px solid #D9E0EE; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 6px 22px 6px 12px; border-radius: 8px; }
QMenu::item:selected { background: #EAF1FD; color: #0F1A3A; }
QMenu::separator { height: 1px; background: #E3E8F1; margin: 4px 8px; }
QToolBar { background: transparent; border: none; spacing: 6px; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 10px; padding: 5px; }
QToolButton:hover { background: #EAF1FD; border-color: #CFE0FA; }
QToolButton:pressed { background: #CFE0FA; }
QToolButton:disabled { opacity: 0.4; }
QToolButton::menu-indicator { image: none; }
QTreeWidget#tvUserList::item, QTreeWidget#tvUserList::item:selected, QTreeWidget#tvUserList::item:hover { background: transparent; border: none; }
QTreeWidget#tvUserList { show-decoration-selected: 0; alternate-background-color: #FFFFFF; selection-background-color: transparent; selection-color: palette(text); }
QTreeWidget#tvUserList::branch { background: transparent; }
QListView#lvTransferList { selection-background-color: #EAF1FD; selection-color: #0F1A3A; }

/* ---- text fields ---- */
QLineEdit { placeholder-text-color: #8A94AD; }

/* ---- MANARA header, search, empty state ---- */
QWidget#brandBar { background: transparent; }
QLabel#brandName { color: #0F1A3A; font-size: 13pt; font-weight: 800; letter-spacing: 1px; }
QLabel#brandSub { color: #F28C28; font-size: 10pt; font-weight: 600; }
QLineEdit#txtSearch { background: #FFFFFF; border: 1px solid #E3E8F1; border-radius: 14px; padding: 6px 12px; color: #0F1A3A; }
QLineEdit#txtSearch:focus { border-color: #1E4FC2; }
QLabel#lblEmpty { color: #6B7794; background: #FFFFFF; border: 1px solid #E3E8F1; border-radius: 12px; padding: 24px; }

/* ---- bottom tab bar, menu button, chat header ---- */
QWidget#wgtToolBar QToolButton { color: #4A5575; font-size: 8pt; padding: 4px 0; border-radius: 10px; min-width: 0; max-width: 100px; }
QWidget#wgtToolBar QToolButton:hover { background: #EAF1FD; color: #1E4FC2; }
QWidget#wgtToolBar QToolButton:disabled { color: #A9B2C7; }
QToolButton#btnMainMenu { color: #0F1A3A; font-size: 16pt; font-weight: 700; border: none; padding: 0 8px; }
QToolButton#btnMainMenu::menu-indicator { image: none; }
QWidget#chatHeader { background: #FFFFFF; border-bottom: 1px solid #E3E8F1; }
QLabel#chatHeaderName { color: #0F1A3A; font-size: 12pt; font-weight: 700; }
QLabel#chatHeaderNote { color: #6B7794; font-size: 9pt; }

/* ---- first-run welcome ---- */
QLabel#welcomeTitle { color: #0F1A3A; font-size: 15pt; font-weight: 800; }
QLabel#welcomeNotes { color: #6B7794; font-size: 9pt; }
QPushButton#btnWelcomeStart { background: #1E4FC2; color: #FFFFFF; border: none; border-radius: 12px; padding: 9px 18px; font-weight: 700; }
QPushButton#btnWelcomeStart:hover { background: #F28C28; }

QWidget#wgtToolBar QToolBar { padding: 0 10px; border: none; }
